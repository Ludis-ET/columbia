# ---------------------------------------------------------------------------
# Supabase — required for the admin console and the tour form.
# The public site still builds and serves without these: every content read
# falls back to content/source-of-truth.json. See src/lib/db/queries.ts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Canonical origin. Set this in production, or canonical tags and the sitemap
# will point at a preview deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://columbiacareafh.com

# ---------------------------------------------------------------------------
# Email (Resend). Optional — without it an enquiry is still SAVED, and the
# owner still finds it in the admin inbox. Only the notification is skipped.
#   RESEND_FROM must be a domain verified in Resend. Until it is, Resend's
#   shared sender only delivers to the account owner's own address.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Columbia Care <tours@columbiacareafh.com>
OWNER_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile. Optional — spam checking FAILS OPEN when unset, because
# losing a real family's enquiry is worse than letting spam through. The
# honeypot still catches naive bots.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# NEVER set a service-role key here. This codebase deliberately has no
# service-role client: admin writes run as the signed-in user so RLS authorises
# them. See docs/admin-setup.md.
#
# The one exception: `pnpm admin:seed` reads SUPABASE_SERVICE_ROLE_KEY from
# .env.local to create a dev admin account. Keep it local, never commit it.
# SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
