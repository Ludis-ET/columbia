# Supabase — public client credentials.
# The publishable key is safe in the browser: it grants only what row-level
# security allows. Every table is deny-by-default with an explicit public-read
# policy for published rows only. See supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit.
# Needed for admin writes and the seed script (Phase 5).
# SUPABASE_SERVICE_ROLE_KEY=
