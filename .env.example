# ---------------------------------------------------------------------------
# Supabase — required for the admin console and the tour form.
# The public site still builds and serves without these: every content read
# falls back to content/source-of-truth.json. See src/lib/db/queries.ts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Canonical origin. Set this in production, or canonical tags and the sitemap
# will point at a preview deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://columbiacareafh.com

# ---------------------------------------------------------------------------
# Server Actions encryption key - recommended for consistent keys across builds.
# Next.js normally generates this at build time. Passenger restarts alone do
# not rotate the built key. To keep it stable across deployments, generate:
#   openssl rand -base64 32
# Store the same value in GitHub Actions secrets and cPanel runtime settings.
# ---------------------------------------------------------------------------
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email Configuration (cPanel SMTP or Resend).
#
# Option A: cPanel Outgoing Email (Recommended for cPanel hosting)
#   Configure with your cPanel email account credentials:
#   - SMTP_HOST: usually mail.columbiacareafh.com (or localhost)
#   - SMTP_PORT: 465 (SSL) or 587 (TLS)
#   - SMTP_USER: your cPanel email account (e.g. noreply@columbiacareafh.com)
#   - SMTP_PASS: the real mailbox password, not the cPanel login password
#   Configure these in cPanel > Setup Node.js App > Environment variables.
#   Restart the app after saving. Editing .env.example does not configure it.
#   - SMTP_FROM: "Columbia Care <noreply@columbiacareafh.com>"
# ---------------------------------------------------------------------------
SMTP_HOST=mail.columbiacareafh.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@columbiacareafh.com
SMTP_PASS=
SMTP_FROM=Columbia Care <noreply@columbiacareafh.com>

# Option B: Resend API (Alternative to cPanel)
# RESEND_API_KEY=
# RESEND_FROM=Columbia Care <noreply@columbiacareafh.com>

# Owner and stakeholder recipient lists are combined and deduplicated.
# The three primary stakeholder addresses remain included by default.
OWNER_NOTIFICATION_EMAIL=Wondimubelete4@gmail.com,Zgenet19@gmail.com,leulsegedmelaku1020@gmail.com
STAKEHOLDER_EMAILS=Wondimubelete4@gmail.com,Zgenet19@gmail.com,leulsegedmelaku1020@gmail.com

# ---------------------------------------------------------------------------
# Cloudflare Turnstile. Optional — spam checking FAILS OPEN when unset, because
# losing a real family's enquiry is worse than letting spam through. The
# honeypot still catches naive bots.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# NEVER set a service-role key here. This codebase deliberately has no
# service-role client: admin writes run as the signed-in user so RLS authorises
# them. See docs/admin-setup.md.
#
# The one exception: `pnpm admin:seed` reads SUPABASE_SERVICE_ROLE_KEY from
# .env.local to create a dev admin account. Keep it local, never commit it.
# SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
